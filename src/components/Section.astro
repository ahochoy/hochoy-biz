---
interface Props {
  title: string;
  collapsible?: boolean;
  defaultOpen?: boolean;
  /** 'stack' puts the label on its own rule; 'inline' seats it beside the content. */
  layout?: 'stack' | 'inline';
  accent?: boolean;
}
const {
  title,
  collapsible = false,
  defaultOpen = true,
  layout = 'stack',
  accent = false,
} = Astro.props;

const sectionId = `section-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section
  class:list={["section", `section--${layout}`]}
  id={sectionId}
  data-section-id={sectionId}
>
  <div class="section-header">
    <h2 class:list={["eyebrow", "section-title", { "section-title--accent": accent }]}>{title}</h2>

    {collapsible && (
      <button
        class="section-toggle"
        aria-expanded={defaultOpen ? "true" : "false"}
        aria-controls={`${sectionId}-body`}
        data-toggle-target={sectionId}
        aria-label={`Toggle ${title} section`}
      >
        <span class="toggle-icon" aria-hidden="true">{defaultOpen ? '−' : '+'}</span>
      </button>
    )}
  </div>

  <div
    class="section-body"
    id={`${sectionId}-body`}
    data-section-body={sectionId}
    style={collapsible && !defaultOpen ? "display: none" : ""}
  >
    <slot />
  </div>
</section>

{collapsible && (
  <script>
    declare global {
      interface Window {
        __sectionToggleInit?: boolean;
      }
    }
    if (!window.__sectionToggleInit) {
      window.__sectionToggleInit = true;
      document.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest('[data-toggle-target]') as HTMLButtonElement | null;
        if (!btn) return;

        const sectionId = btn.dataset.toggleTarget;
        const body = document.querySelector(`[data-section-body="${sectionId}"]`) as HTMLElement | null;
        if (!body) return;

        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const icon = btn.querySelector('.toggle-icon');

        if (isExpanded) {
          body.style.display = 'none';
          btn.setAttribute('aria-expanded', 'false');
          if (icon) icon.textContent = '+';
        } else {
          body.style.display = '';
          btn.setAttribute('aria-expanded', 'true');
          if (icon) icon.textContent = '−';
        }
      });
    }
  </script>
)}

<style>
  .section {
    border-bottom: 1px solid var(--color-rule);
  }

  /* ── Stacked: label rides its own hairline rule ─────────── */
  .section--stack .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: clamp(0.65rem, 1.2vw, 0.9rem) var(--pad-x);
    border-bottom: 1px solid var(--color-rule);
    min-height: 2.75rem;
  }

  /* ── Inline: label sits to the left of the content ──────── */
  .section--inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding: clamp(1rem, 2.25vw, 1.5rem) var(--pad-x);
  }

  .section--inline .section-header {
    flex: none;
  }

  .section--inline .section-body {
    flex: 1 1 20rem;
  }

  .section-title {
    color: var(--color-text-muted);
  }

  .section-title--accent {
    color: var(--color-accent);
  }

  /* ── Toggle ─────────────────────────────────────────────── */
  .section-toggle {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    background: none;
    border: 1px solid transparent;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: color 0.18s ease,
                border-color 0.18s ease,
                transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .section-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .section-toggle:active {
    transform: scale(0.94);
  }

  .section-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .toggle-icon {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    line-height: 1;
  }
</style>
