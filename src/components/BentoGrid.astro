---
import capabilities from '../data/capabilities.json';
---

<div class="cap-grid">
  {capabilities.map((cap, i) => (
    <div class="cap-cell" data-id={cap.id}>
      <span class="cap-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="cap-title">{cap.title}</h3>
      {cap.description && <p class="cap-desc">{cap.description}</p>}
    </div>
  ))}
  <div class="cap-cell cap-cell--mark" aria-hidden="true"></div>
</div>

<style>
  /* Cells float on a rule-coloured ground; the 1px gaps read as printed rules. */
  .cap-grid {
    --cap-pad: clamp(0.875rem, 1.75vw, 1.25rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-rule-hair);
  }

  .cap-cell {
    background: var(--color-bg);
    padding: var(--cap-pad) var(--cap-pad) clamp(1.125rem, 2vw, 1.5rem);
    transition: background 0.18s ease;
  }

  .cap-cell:hover {
    background: var(--color-surface);
  }

  .cap-num {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--label-size);
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: 0.6rem;
  }

  .cap-title {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(0.875rem, 1.15vw, 1rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }

  .cap-desc {
    font-size: clamp(0.8125rem, 0.95vw, 0.875rem);
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  /* Fills the seventh gap so the grid stays a complete rectangle. */
  .cap-cell--mark {
    background: var(--color-surface);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 6px,
      var(--color-rule-hair) 6px 7px
    );
  }

  .cap-cell--mark:hover {
    background: var(--color-surface);
  }

  /* Edge columns carry the page gutter so cell text lines up with every
     other section, while the 1px rules still run full-bleed. */
  .cap-cell:nth-child(4n + 1) { padding-left: var(--pad-x); }
  .cap-cell:nth-child(4n)     { padding-right: var(--pad-x); }
  .cap-cell:last-child        { padding-right: var(--pad-x); }

  @media (max-width: 900px) {
    .cap-grid { grid-template-columns: repeat(2, 1fr); }

    /* Reset the 4-column edges before applying the 2-column ones. */
    .cap-cell:nth-child(4n + 1) { padding-left: var(--cap-pad); }
    .cap-cell:nth-child(4n)     { padding-right: var(--cap-pad); }

    .cap-cell:nth-child(2n + 1) { padding-left: var(--pad-x); }
    .cap-cell:nth-child(2n)     { padding-right: var(--pad-x); }
    .cap-cell:last-child        { padding-right: var(--pad-x); }
  }

  @media (max-width: 520px) {
    .cap-grid { grid-template-columns: 1fr; }
    .cap-cell--mark { display: none; }

    .cap-cell {
      padding-left: var(--pad-x);
      padding-right: var(--pad-x);
    }
  }
</style>
