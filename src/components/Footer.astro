---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <span class="footer-name">Andrew HoChoy</span>
  <span class="eyebrow footer-meta">&copy; {year} — Bay Area, CA</span>
</footer>

<style>
  .site-footer {
    padding: clamp(0.875rem, 1.75vw, 1.25rem) var(--pad-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .footer-name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    color: var(--color-text);
  }

  .footer-meta {
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
  }
</style>
