---
import companies from '../data/companies.json';
---

<div class="logo-row">
  {companies.map((co) => (
    co.logoUrl
      ? <img src={co.logoUrl} alt={co.name} loading="lazy" class="logo-img" />
      : <span class="logo-word">{co.name}</span>
  ))}
</div>

<style>
  .logo-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 2rem);
  }

  .logo-word {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1.9vw, 1.5rem);
    line-height: 1;
    color: var(--color-body);
    transition: color 0.18s ease;
  }

  .logo-word:hover {
    color: var(--color-accent);
  }

  .logo-img {
    height: clamp(1.25rem, 2.4vw, 1.75rem);
    width: auto;
    max-width: 140px;
    object-fit: contain;
    opacity: 0.6;
    filter: grayscale(1);
    transition: opacity 0.18s ease, filter 0.18s ease;
  }

  .logo-img:hover {
    opacity: 1;
    filter: grayscale(0);
  }
</style>
