---
interface Props {
  icon?: string;
  title: string;
  description?: string;
  href: string;
  thumbnailUrl?: string;
  comingSoon?: boolean;
  /** 1-based position, printed as the row's set number. */
  index?: number;
  variant?: 'row' | 'cta';
}
const {
  title,
  description,
  href,
  thumbnailUrl,
  comingSoon = false,
  index,
  variant = 'row',
} = Astro.props;

// Titles arrive as "Instagram / @ahochoy" — the handle is set in mono beside the name.
const [name, ...handleParts] = title.split(' / ');
const handle = handleParts.join(' / ');
const num = index !== undefined ? String(index).padStart(2, '0') : undefined;
const Tag = comingSoon ? 'div' : 'a';
---

<Tag
  href={comingSoon ? undefined : href}
  target={comingSoon ? undefined : "_blank"}
  rel={comingSoon ? undefined : "noopener noreferrer"}
  class:list={["card", `card--${variant}`, { "card--static": comingSoon }]}
>
  {num && <span class="card-num" aria-hidden="true">{num}</span>}

  {thumbnailUrl && <img src={thumbnailUrl} alt="" class="card-thumbnail" loading="lazy" />}

  <div class="card-body">
    <span class="card-title">
      {name}{handle && <span class="card-handle"> /{handle.replace(/^@/, '')}</span>}
    </span>
    {description && <p class="card-desc">{description}</p>}
  </div>

  {comingSoon
    ? <span class="eyebrow card-chip">Coming soon</span>
    : <span class="card-arrow" aria-hidden="true">→</span>
  }
</Tag>

<style>
  .card {
    display: flex;
    align-items: baseline;
    gap: clamp(0.625rem, 1.25vw, 1rem);
    padding: clamp(0.75rem, 1.5vw, 1.1rem) var(--pad-x);
    border-bottom: 1px solid var(--color-rule-hair);
    width: 100%;
    position: relative;
    transition: background 0.18s ease;
  }

  .card:last-child {
    border-bottom: none;
  }

  a.card:hover {
    background: var(--color-surface);
  }

  a.card:hover .card-arrow {
    transform: translateX(3px);
    color: var(--color-accent);
  }

  a.card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  a.card:active .card-arrow {
    transform: translateX(1px);
  }

  /* ── Set number ─────────────────────────────────────────── */
  .card-num {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--label-size);
    font-weight: 500;
    color: var(--color-accent);
    width: 1.5rem;
  }

  .card-thumbnail {
    flex: none;
    width: clamp(2.5rem, 5vw, 3.25rem);
    height: clamp(2.5rem, 5vw, 3.25rem);
    object-fit: cover;
    align-self: center;
  }

  .card-body {
    flex: 1;
    min-width: 0;
  }

  .card-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .card-handle {
    font-family: var(--font-mono);
    font-size: clamp(0.6875rem, 0.95vw, 0.8125rem);
    color: var(--color-text-muted);
  }

  .card-desc {
    font-size: clamp(0.8125rem, 1vw, 0.9375rem);
    line-height: 1.45;
    color: var(--color-body);
    margin-top: 0.2rem;
  }

  .card-arrow {
    flex: none;
    font-size: 0.9375rem;
    color: var(--color-accent);
    transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), color 0.18s ease;
  }

  /* ── Coming-soon chip ───────────────────────────────────── */
  .card-chip {
    flex: none;
    align-self: center;
    color: var(--color-text);
    border: 1px solid var(--color-rule);
    padding: 0.55em 0.7em;
    white-space: nowrap;
  }

  /* ── CTA variant ────────────────────────────────────────── */
  .card--cta {
    padding: 0;
    border-bottom: none;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .card--cta .card-title {
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    line-height: 1.15;
  }

  .card--cta .card-desc {
    max-width: 60ch;
    margin-top: 0.25rem;
  }

  @media (max-width: 640px) {
    .card--cta {
      flex-wrap: wrap;
    }

    .card--cta .card-body {
      flex: 1 1 100%;
    }

    .card--cta .card-chip {
      align-self: flex-start;
    }
  }
</style>
