---
import NavStrip from './NavStrip.astro';
---

<header class="hero">
  <!-- Inked panel: 1-bit dithered sphere lit by a rotating source -->
  <div class="hero-panel">
    <canvas id="hero-dither" class="hero-canvas" aria-hidden="true"></canvas>
    <NavStrip />
    <span class="eyebrow hero-fig">Fig. 1 — Halftone / rotating light</span>
  </div>

  <!-- Masthead on paper -->
  <div class="hero-masthead">
    <p class="eyebrow hero-kicker">Educator · Engineer · Entrepreneur</p>

    <h1 class="hero-name">Andrew <span class="hero-name-accent">HoChoy.</span></h1>

    <div class="hero-foot">
      <p class="hero-tagline">
        Digital Consultant and AI champion based in the Bay Area.
        Helping businesses leverage technology to drive real results.
      </p>
      <a href="#call-to-action" class="eyebrow hero-scroll">Scroll ↓</a>
    </div>
  </div>
</header>

<script>
  // 4×4 Bayer ordered-dither threshold matrix, normalised to 0–1.
  const BAYER = [
    [0, 8, 2, 10],
    [12, 4, 14, 6],
    [3, 11, 1, 9],
    [15, 7, 13, 5],
  ].map((row) => row.map((v) => (v + 0.5) / 16));

  const PIXEL = 4;

  type RGB = [number, number, number];

  // Palette lives in CSS custom properties so the halftone follows the theme:
  // blue-on-paper in light mode, neon-on-ink in dark.
  const hexToRgb = (value: string): RGB => {
    let hex = value.trim().replace('#', '');
    if (hex.length === 3) hex = hex.split('').map((c) => c + c).join('');
    const n = parseInt(hex, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  };

  const canvas = document.getElementById('hero-dither') as HTMLCanvasElement | null;

  if (canvas) {
    const ctx = canvas.getContext('2d');
    const buffer = document.createElement('canvas');
    const bctx = buffer.getContext('2d');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    let w = 0;
    let h = 0;
    let img: ImageData | null = null;
    let raf = 0;
    let t = 0;
    let ground: RGB = [244, 241, 232];
    let dither: RGB = [31, 63, 216];

    const readPalette = () => {
      const styles = getComputedStyle(canvas);
      ground = hexToRgb(styles.getPropertyValue('--hero-bg') || '#f4f1e8');
      dither = hexToRgb(styles.getPropertyValue('--hero-dither') || '#1f3fd8');
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      if (!rect.width || !rect.height || !ctx || !bctx) return;
      canvas.width = Math.round(rect.width);
      canvas.height = Math.round(rect.height);
      w = Math.max(1, Math.ceil(canvas.width / PIXEL));
      h = Math.max(1, Math.ceil(canvas.height / PIXEL));
      buffer.width = w;
      buffer.height = h;
      img = bctx.createImageData(w, h);
      readPalette();
      draw();
    };

    const draw = () => {
      if (!ctx || !bctx || !img) return;
      const data = img.data;
      const cx = w / 2;
      const cy = h / 2;
      const R = Math.min(cx, cy) * 1.05;
      // Light source orbits the sphere on two out-of-phase axes.
      const lx = Math.cos(t * 0.6);
      const ly = Math.sin(t * 0.42) * 0.5;
      const lz = 0.75;

      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const dx = x - cx;
          const dy = y - cy;
          const r = Math.sqrt(dx * dx + dy * dy);
          // Fade the whole field out under the nav strip.
          const fade = Math.min(1, Math.max(0, (y / h - 0.18) / 0.22));

          let value: number;
          if (r > R) {
            value = (0.05 + Math.sin(r * 0.3 - t * 1.4) * 0.04) * fade;
          } else {
            const nx = dx / R;
            const ny = dy / R;
            const nz = Math.sqrt(Math.max(0, 1 - nx * nx - ny * ny));
            const l = Math.max(0, nx * lx + ny * ly + nz * lz);
            const u = Math.atan2(ny, nx);
            const band = Math.sin(u * 4 + nz * 8 - t * 1.6) * 0.06;
            value = (Math.pow(l, 2.1) * 0.72 + band) * fade;
          }

          const v = Math.max(0, Math.min(1, value));
          const on = v > BAYER[y & 3][x & 3];
          const c = on ? dither : ground;
          const i = (y * w + x) * 4;
          data[i] = c[0];
          data[i + 1] = c[1];
          data[i + 2] = c[2];
          data[i + 3] = 255;
        }
      }

      bctx.putImageData(img, 0, 0);
      ctx.imageSmoothingEnabled = false;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(buffer, 0, 0, canvas.width, canvas.height);
    };

    const loop = () => {
      t += 0.016;
      draw();
      raf = requestAnimationFrame(loop);
    };

    const start = () => {
      cancelAnimationFrame(raf);
      if (reduced.matches) {
        // One resolved frame: lit from the upper left, no motion.
        t = 1.2;
        draw();
      } else {
        loop();
      }
    };

    // Repaint whenever the theme class flips so the palette swaps instantly,
    // including while paused for reduced motion.
    new MutationObserver(() => {
      readPalette();
      if (reduced.matches) draw();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    new ResizeObserver(resize).observe(canvas);
    reduced.addEventListener('change', start);
    readPalette();
    resize();
    start();
  }
</script>

<style>
  .hero {
    border-bottom: 1px solid var(--color-rule);
  }

  /* ── Inked panel ──────────────────────────────────────── */
  .hero-panel {
    position: relative;
    background: var(--hero-bg);
    border-bottom: 1px solid var(--color-rule);
    height: clamp(16rem, 38svh, 28rem);
    overflow: hidden;
  }

  .hero-canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  .hero-fig {
    position: absolute;
    left: var(--pad-x);
    bottom: clamp(0.75rem, 1.5vw, 1.25rem);
    z-index: 2;
    color: var(--hero-mark);
    background: var(--hero-bg);
    padding: 0.35em 0.5em;
  }

  /* ── Masthead ─────────────────────────────────────────── */
  .hero-masthead {
    padding: clamp(1.75rem, 4vw, 3rem) var(--pad-x) clamp(1.5rem, 3.5vw, 2.75rem);
  }

  .hero-kicker {
    color: var(--color-text-muted);
    margin-bottom: clamp(0.75rem, 1.75vw, 1.25rem);
  }

  .hero-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.25rem, 12vw, 9.5rem);
    line-height: 0.84;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: clamp(1rem, 2.25vw, 1.75rem);
  }

  .hero-name-accent {
    font-style: italic;
    color: var(--color-accent);
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .hero-tagline {
    flex: 1 1 22ch;
    max-width: 52ch;
    font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
    line-height: 1.5;
    color: var(--color-body);
  }

  .hero-scroll {
    flex: none;
    background: var(--yellow);
    color: var(--ink);
    padding: 0.7em 0.85em;
    transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.18s ease;
  }

  .hero-scroll:hover {
    transform: translateY(2px);
  }

  .hero-scroll:active {
    opacity: 0.8;
  }

  .hero-scroll:focus-visible {
    outline: 2px solid var(--color-rule);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .hero-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: clamp(1rem, 4vw, 1.5rem);
    }

    .hero-tagline {
      flex: 1 1 auto;
    }
  }
</style>
