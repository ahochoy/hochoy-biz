---
import contactData from '../data/contact.json';

// Rank the buttons: primary (blue), secondary (outline), highlight (neon).
const tones = ['primary', 'ghost', 'highlight'] as const;
---

<div class="contact-row">
  {contactData.map((btn, i) => (
    <a
      href={btn.href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={["contact-btn", `contact-btn--${tones[i % tones.length]}`]}
    >
      {btn.label} <span aria-hidden="true">→</span>
    </a>
  ))}
</div>

<style>
  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .contact-btn {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(0.8125rem, 1vw, 0.9375rem);
    line-height: 1;
    padding: 0.75em 0.95em;
    border: 1px solid transparent;
    transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.18s ease;
  }

  .contact-btn:hover {
    transform: translateY(-2px);
  }

  .contact-btn:active {
    transform: translateY(0);
    opacity: 0.85;
  }

  .contact-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .contact-btn--primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .contact-btn--ghost {
    border-color: var(--color-rule);
    color: var(--color-text);
  }

  .contact-btn--highlight {
    background: var(--yellow);
    border-color: var(--color-rule);
    color: var(--ink);
  }
</style>
