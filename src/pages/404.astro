---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found | Andrew HoChoy" description="This page doesn't exist.">
  <div class="not-found">
    <p class="eyebrow not-found-label">Error 404</p>
    <div class="not-found-number">404</div>
    <h1 class="not-found-heading">Page <span class="not-found-accent">not found.</span></h1>
    <p class="not-found-body">This page doesn't exist or has moved.</p>
    <a href="/" class="not-found-link">← Back home</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: var(--space-xl) var(--pad-x);
    border-bottom: 1px solid var(--color-rule);
  }

  .not-found-label {
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .not-found-number {
    font-family: var(--font-display);
    font-size: clamp(6rem, 20vw, 16rem);
    line-height: 0.84;
    letter-spacing: -0.03em;
    color: var(--color-rule-hair);
  }

  .not-found-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-text);
    margin-top: var(--space-md);
  }

  .not-found-accent {
    font-style: italic;
    color: var(--color-accent);
  }

  .not-found-body {
    font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
    color: var(--color-body);
    margin-top: var(--space-sm);
  }

  .not-found-link {
    margin-top: var(--space-lg);
    padding: 0.75em 0.95em;
    background: var(--yellow);
    color: var(--ink);
    border: 1px solid var(--color-rule);
    font-weight: 500;
    font-size: clamp(0.8125rem, 1vw, 0.9375rem);
    line-height: 1;
    transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.18s ease;
  }

  .not-found-link:hover { transform: translateY(-2px); }
  .not-found-link:active { transform: translateY(0); opacity: 0.85; }

  .not-found-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
