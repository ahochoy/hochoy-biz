---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import BentoGrid from '../components/BentoGrid.astro';
import CompanyLogos from '../components/CompanyLogos.astro';
import Contact from '../components/Contact.astro';

import ctaData from '../data/cta.json';
import connectData from '../data/connect.json';
import contentData from '../data/content.json';
---

<BaseLayout
  title="Andrew HoChoy"
  description="Consultant, speaker, and entrepreneur based in the Bay Area. Helping businesses leverage AI and technology to grow."
>
  <Hero />

  <main>
    <Section title="Call to Action" layout="inline" accent={true} collapsible={false}>
      {ctaData.map((item) => (
        <Card
          variant="cta"
          title={item.title}
          description={item.description}
          href={item.href}
          comingSoon={item.comingSoon}
        />
      ))}
    </Section>

    <Section title="Connect" collapsible={true} defaultOpen={true}>
      {connectData.map((item, i) => (
        <Card
          index={i + 1}
          title={item.title}
          description={item.description}
          href={item.href}
        />
      ))}
    </Section>

    <Section title="Content" collapsible={true} defaultOpen={true}>
      {contentData.map((item, i) => (
        <Card
          index={connectData.length + i + 1}
          title={item.title}
          description={item.description}
          href={item.href}
        />
      ))}
    </Section>

    <Section title="Capabilities" collapsible={false}>
      <BentoGrid />
    </Section>

    <Section title="Companies I've Worked With" layout="inline" collapsible={false}>
      <CompanyLogos />
    </Section>

    <Section title="Contact" layout="inline" collapsible={false}>
      <Contact />
    </Section>
  </main>
</BaseLayout>
