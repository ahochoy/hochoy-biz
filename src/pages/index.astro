---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import BentoGrid from '../components/BentoGrid.astro';
import CompanyLogos from '../components/CompanyLogos.astro';
import Contact from '../components/Contact.astro';
import Newsletter from '../components/Newsletter.astro';
import Householder from '../components/Householder.astro';
import Currently from '../components/Currently.astro';

import ctaData from '../data/cta.json';
import connectData from '../data/connect.json';

// Call to Action is parked for now. Flip to true to bring the section back;
// its content still lives in src/data/cta.json.
const showCta = false;
---

<BaseLayout
  title="Andrew HoChoy"
  description="Consultant, speaker, and entrepreneur based in the Bay Area. Helping businesses leverage AI and technology to grow."
>
  <Hero />

  <main>
    <Section title="Currently" layout="inline" collapsible={false}>
      <Currently />
    </Section>

    {showCta && (
      <Section title="Call to Action" layout="inline" accent={true} collapsible={false}>
        {ctaData.map((item) => (
          <Card
            variant="cta"
            title={item.title}
            description={item.description}
            href={item.href}
            comingSoon={item.comingSoon}
          />
        ))}
      </Section>
    )}

    <Section title="Connect" collapsible={true} defaultOpen={true}>
      {connectData.map((item, i) => (
        <Card
          index={i + 1}
          title={item.title}
          description={item.description}
          href={item.href}
        />
      ))}
    </Section>

    <Section title="Content" collapsible={true} defaultOpen={true}>
      <Newsletter />
    </Section>

    <Section title="Capabilities" collapsible={true} defaultOpen={true}>
      <BentoGrid />
    </Section>

    <Section title="Companies I've Worked With" layout="inline" collapsible={false}>
      <CompanyLogos />
    </Section>

    <Householder />

    <Section title="Contact" layout="inline" collapsible={false}>
      <Contact />
    </Section>
  </main>
</BaseLayout>
