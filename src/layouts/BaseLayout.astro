---
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Andrew HoChoy",
  description = "Consultant, Speaker, Entrepreneur — Bay Area"
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /* ─── Design Tokens ──────────────────────────────────────── */
      :root {
        /* Raw brand values */
        --paper:   #f4f1e8;
        --ink:     #17150f;
        --blue:    #1f3fd8;
        --yellow:  #e6ff2e;

        /* Semantic surface + text */
        --color-bg:         var(--paper);
        --color-text:       var(--ink);
        --color-body:       #3a3527;
        --color-text-muted: #6e6858;
        --color-surface:    #eee9dc;

        /* Rules: heavy structural rule + hairline row divider */
        --color-rule:      var(--ink);
        --color-rule-hair: #d8d2c2;

        /* Hero panel — the halftone prints blue on paper in daylight,
           neon on ink after dark. */
        --hero-bg:     var(--paper);
        --hero-dither: var(--blue);
        --hero-fg:     var(--ink);
        --hero-fg-dim: #6e6858;
        --hero-mark:   var(--blue);
        --hero-hairline: rgba(23, 21, 15, 0.28);

        /* Accents */
        --color-accent:          var(--blue);
        --color-accent-contrast: var(--paper);
        --color-highlight:       var(--yellow);
        --color-highlight-ink:   var(--ink);

        /* Typography */
        --font-display: 'Instrument Serif', Georgia, serif;
        --font-body:    'Space Grotesk', system-ui, sans-serif;
        --font-mono:    'JetBrains Mono', ui-monospace, Menlo, monospace;

        /* Alias kept for any legacy reference */
        --font-heading: var(--font-display);

        /* Fluid spacing — Utopia-based */
        --space-xs:   clamp(0.25rem, 0.5vw, 0.375rem);
        --space-sm:   clamp(0.5rem,  1vw,   0.75rem);
        --space-md:   clamp(1rem,    2vw,   1.5rem);
        --space-lg:   clamp(1.5rem,  3vw,   2.5rem);
        --space-xl:   clamp(2.5rem,  5vw,   4rem);
        --space-2xl:  clamp(4rem,    8vw,   7rem);

        /* Horizontal page padding */
        --pad-x: clamp(1.25rem, 4vw, 4.5rem);

        /* Mono label treatment used across every section eyebrow */
        --label-size: clamp(0.625rem, 0.85vw, 0.75rem);
        --label-track: 0.2em;
      }

      /* Dark mode — the paper turns to ink, the ink to paper.
         Blue lifts so it keeps contrast against a dark ground. */
      .dark {
        --color-bg:         #141310;
        --color-text:       var(--paper);
        --color-body:       #cfc9b8;
        --color-text-muted: #8d8778;
        --color-surface:    #1c1a15;

        --color-rule:      #4a4433;
        --color-rule-hair: #2a2620;

        --color-accent:          #7b90ff;
        --color-accent-contrast: #0f0e0b;

        --hero-bg:     var(--ink);
        --hero-dither: var(--yellow);
        --hero-fg:     var(--paper);
        --hero-fg-dim: #8d8778;
        --hero-mark:   var(--yellow);
        --hero-hairline: rgba(244, 241, 232, 0.28);
      }

      /* ─── Reset ──────────────────────────────────────────────── */
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-size: 16px;
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: clamp(0.9375rem, 1vw, 1.0625rem);
        line-height: 1.55;
        min-height: 100vh;
        transition: background-color 0.25s ease, color 0.25s ease;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      /* Shared mono eyebrow, used by every section label */
      .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--label-size);
        font-weight: 500;
        letter-spacing: var(--label-track);
        text-transform: uppercase;
        line-height: 1;
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
    <script is:inline src="/favicon.js"></script>
    <!-- Google tag (gtag.js) -->
    <script type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=G-1RF11BBD3P"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-1RF11BBD3P');
    </script>
  </head>
  <body>
    <slot />

    <Footer />

    <!-- Dark/light mode persistence -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </body>
</html>
